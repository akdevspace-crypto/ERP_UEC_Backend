  @@index([admissionId])
  @@index([allocationId])
  @@index([enquiryId])
  @@index([patientId])
  @@index([staffId])
  @@index([startAt])
  @@index([status])
  @@index([taskId])
  @@index([tenantId])
  @@index([unitId])
}

model PatientDailyCost {
  id            String    @id
  costNo        String    @unique
  allocationId  String
  admissionId   String?
  patientId     String?
  patientName   String
  clientName    String?
  serviceType   String
  costDate      DateTime  @db.Date
  category      String
  description   String
  quantity      Float     @default(1)
  rate          Float     @default(0)
  amount        Float     @default(0)
  sourceType    String?
  sourceId      String?
  status        String    @default("DRAFT")
  invoiceId     String?
  invoiceRefNo  String?
  sentAt        DateTime?
  sentVia       String?
