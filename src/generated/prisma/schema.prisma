// --- UNCF, Funding & Projects ---
model FundingCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  tenantId    String
  unitId      String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  projects    Project[]
}

model ProjectClassification {
  id          String    @id @default(uuid())
  name        String
  description String?
  tenantId    String
  unitId      String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  projects    Project[]
}

model Project {
  id               String    @id @default(uuid())
  name             String
  description      String?
  categoryId       String?
  classificationId String?
  totalBudget      Float     @default(0)
  startDate        DateTime?
  endDate          DateTime?
  status           String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, CANCELLED
  approvalStatus   String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById     String?
  tenantId         String
  unitId           String?
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  category       FundingCategory?       @relation(fields: [categoryId], references: [id])
  classification ProjectClassification? @relation(fields: [classificationId], references: [id])
  allocations    FundingAllocation[]
  expenditures   ProjectExpenditure[]
}

model FundingAllocation {
  id        String   @id @default(uuid())
  projectId String
  amount    Float
  source    String?
  notes     String?
  date      DateTime @default(now())
  tenantId  String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
}

model ProjectExpenditure {
  id             String   @id @default(uuid())
  projectId      String
  amount         Float
  description    String?
  category       String?
  date           DateTime @default(now())
  approvalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById   String?
  tenantId       String
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
}

model Notification {
  id         String    @id @default(uuid())
  title      String
  body       String
  type       String    @default("INFO")
  userId     String?
  role       String?
  isRead     Boolean   @default(false)
  entityType String?
  entityId   String?
  metadata   Json?
  tenantId   String
  unitId     String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([userId])
  @@index([isRead])
}

model NotificationTemplate {
  id        String    @id @default(uuid())
  name      String
  title     String
  body      String
  type      String    @default("INFO")
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model ServiceContract {
  id             String @id @default(uuid())
  contractNumber String @unique
  admissionId    String @unique
  tenantId       String
  unitId         String

  startDate DateTime
  endDate   DateTime?
  status    ContractStatus @default(DRAFT)

  staffRequired       Int?
  shift               String?
  frequency           String?
  careRequirements    Json?
  specialInstructions String?

  servicePrice Float?
  billingCycle String?

  termsSnapshot     Json?
  termsAcceptedAt   DateTime?
  termsAcceptedById String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admission       Admission @relation(fields: [admissionId], references: [id])
  termsAcceptedBy User?     @relation(fields: [termsAcceptedById], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  COMPLETED
}

model ServiceClosure {
  id          String @id @default(uuid())
  admissionId String @unique
  tenantId    String
  unitId      String

  medicalCleared     Boolean   @default(false)
  medicalClearedById String?
  medicalClearedAt   DateTime?

  financeCleared     Boolean   @default(false)
  financeClearedById String?
  financeClearedAt   DateTime?

  assetCleared     Boolean   @default(false)
  assetClearedById String?
  assetClearedAt   DateTime?

  status         ClosureStatus @default(IN_PROGRESS)
  closingRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id])

  medicalClearedBy User? @relation("MedicalClosureApprover", fields: [medicalClearedById], references: [id])
  financeClearedBy User? @relation("FinanceClosureApprover", fields: [financeClearedById], references: [id])
  assetClearedBy   User? @relation("AssetClosureApprover", fields: [assetClearedById], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

enum ClosureStatus {
  IN_PROGRESS
  READY
  EXECUTED
}

enum OutingRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum CompanionType {
  STAFF
  VISITOR
  EXTERNAL
}

enum ResidentMovementStatus {
  OUTSIDE
  RETURNED
}

model ResidentOutingRequest {
  id               String              @id @default(uuid())
  patientId        String
  tenantId         String
  unitId           String
  reason           String?
  destination      String?
  expectedExitAt   DateTime?
  expectedReturnAt DateTime?
  status           OutingRequestStatus @default(PENDING_APPROVAL)

  requestedByUserId String?

  companionType             CompanionType?
  companionStaffId          String?
  companionVisitorProfileId String?
  companionName             String?
  companionPhone            String?
  companionRelation         String?

  materials Json?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient                 Patient         @relation(fields: [patientId], references: [id])
  requestedByUser         User?           @relation("OutingRequester", fields: [requestedByUserId], references: [id])
  companionStaff          Staff?          @relation(fields: [companionStaffId], references: [id])
  companionVisitorProfile VisitorProfile? @relation(fields: [companionVisitorProfileId], references: [id])

  movements ResidentGateMovement[]

  @@index([tenantId])
  @@index([unitId])
  @@index([patientId])
  @@index([status])
  @@index([expectedReturnAt])
}

model ResidentGateMovement {
  id              String @id @default(uuid())
  outingRequestId String @unique
  patientId       String
  tenantId        String
  unitId          String

  exitAt         DateTime?
  actualReturnAt DateTime?

  status ResidentMovementStatus?

  exitRecordedByUserId   String?
  returnRecordedByUserId String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  outingRequest        ResidentOutingRequest @relation(fields: [outingRequestId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id])
  exitRecordedByUser   User?                 @relation("OutingExitRecorder", fields: [exitRecordedByUserId], references: [id])
  returnRecordedByUser User?                 @relation("OutingReturnRecorder", fields: [returnRecordedByUserId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([patientId])
  @@index([outingRequestId])
  @@index([status])
  @@index([exitAt])
  @@index([actualReturnAt])
}

enum StaffDailyMovementStatus {
  INSIDE
  COMPLETED
}

enum StaffGateTripStatus {
  OUTSIDE
  RETURNED
}

model StaffDailyMovement {
  id       String @id @default(uuid())
  tenantId String
  unitId   String
  staffId  String

  entryAt     DateTime?
  finalExitAt DateTime?

  entryRecordedByUserId     String?
  finalExitRecordedByUserId String?

  status StaffDailyMovementStatus @default(INSIDE)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  staff                   Staff @relation(fields: [staffId], references: [id])
  entryRecordedByUser     User? @relation("StaffDailyEntryRecorder", fields: [entryRecordedByUserId], references: [id])
  finalExitRecordedByUser User? @relation("StaffDailyExitRecorder", fields: [finalExitRecordedByUserId], references: [id])

  trips StaffGateTrip[]

  @@index([tenantId])
  @@index([unitId])
  @@index([staffId])
  @@index([status])
  @@index([entryAt])
  @@index([finalExitAt])
}

model StaffGateTrip {
  id         String @id @default(uuid())
  movementId String
  tenantId   String
  unitId     String

  exitAt   DateTime?
  returnAt DateTime?

  reason           String?
  expectedReturnAt DateTime?

  companionType             CompanionType?
  companionStaffId          String?
  companionVisitorProfileId String?
  companionName             String?
  companionPhone            String?
  companionRelation         String?

  materials Json?

  exitRecordedByUserId   String?
  returnRecordedByUserId String?

  status StaffGateTripStatus?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movement                StaffDailyMovement @relation(fields: [movementId], references: [id])
  companionStaff          Staff?             @relation("StaffTripCompanion", fields: [companionStaffId], references: [id])
  companionVisitorProfile VisitorProfile?    @relation("StaffTripCompanionVisitor", fields: [companionVisitorProfileId], references: [id])
  exitRecordedByUser      User?              @relation("StaffTripExitRecorder", fields: [exitRecordedByUserId], references: [id])
  returnRecordedByUser    User?              @relation("StaffTripReturnRecorder", fields: [returnRecordedByUserId], references: [id])

  @@index([movementId])
  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([exitAt])
  @@index([returnAt])
}

enum VehicleMovementStatus {
  INSIDE
  COMPLETED
}

model VehicleMovement {
  id              String  @id @default(cuid())
  tenantId        String
  unitId          String
  vehicleNo       String
  vehicleType     String?
  driverName      String
  driverMobile    String?
  companyName     String?
  purpose         String
  materialDetails String?
  remarks         String?

  entryAt DateTime  @default(now())
  exitAt  DateTime?

  entryUserId String
  exitUserId  String?

  status VehicleMovementStatus @default(INSIDE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

