generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String                  @id @default(uuid())
  name                  String
  code                  String                  @unique
  plan                  String                  @default("ENTERPRISE")
  timezone              String                  @default("UTC")
  isActive              Boolean                 @default(true)
  isDeleted             Boolean                 @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  roles                 Role[]
  units                 Unit[]
  users                 User[]
  FundingCategory       FundingCategory[]
  ProjectClassification ProjectClassification[]
  Project               Project[]
  FundingAllocation     FundingAllocation[]
  ProjectExpenditure    ProjectExpenditure[]

  @@index([isActive])
}

model Unit {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  logoUrl    String?
  shortName  String?
  unitType   String?
  locationId String
  address    String?
  pincode    String?
  email      String?
  phone      String?
  timezone   String?
  status     Boolean   @default(true)
  tenantId   String?
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location  @relation(fields: [locationId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  users      User[]

  @@index([tenantId])
  @@index([locationId])
}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  description String?
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  tenantId     String
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([tenantId])
}

model User {
  id                           String                  @id @default(uuid())
  email                        String?                 @unique
  passwordHash                 String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  deletedAt                    DateTime?
  firstName                    String?
  isActive                     Boolean                 @default(true)
  isDeleted                    Boolean                 @default(false)
  lastName                     String?
  mobile                       String?
  roleId                       String?
  tenantId                     String?
  unitId                       String?
  approvedItems                Approval[]              @relation("ApprovalApprover")
  auditLogs                    AuditLog[]
  staff                        Staff?
  tasksToApprove               Task[]                  @relation("TaskApprovalAuthority")
  tasksAssigned                Task[]                  @relation("TaskAssignee")
  role                         Role?                   @relation(fields: [roleId], references: [id])
  tenant                       Tenant?                 @relation(fields: [tenantId], references: [id])
  unit                         Unit?                   @relation(fields: [unitId], references: [id])
  notifications                Notification[]
  ServiceContract              ServiceContract[]
  medicalApprovals             ServiceClosure[]        @relation("MedicalClosureApprover")
  financeApprovals             ServiceClosure[]        @relation("FinanceClosureApprover")
  assetApprovals               ServiceClosure[]        @relation("AssetClosureApprover")
  approvedVisitorPasses        VisitorPass[]           @relation("VisitorPassApprover")
  outingRequests               ResidentOutingRequest[] @relation("OutingRequester")
  outingExitsRecorded          ResidentGateMovement[]  @relation("OutingExitRecorder")
  outingReturnsRecorded        ResidentGateMovement[]  @relation("OutingReturnRecorder")
  staffDailyEntriesRecorded    StaffDailyMovement[]    @relation("StaffDailyEntryRecorder")
  staffDailyFinalExitsRecorded StaffDailyMovement[]    @relation("StaffDailyExitRecorder")
  staffTripExitsRecorded       StaffGateTrip[]         @relation("StaffTripExitRecorder")
  staffTripReturnsRecorded     StaffGateTrip[]         @relation("StaffTripReturnRecorder")
  vehicleEntriesRecorded       VehicleMovement[]       @relation("VehicleEntryRecorder")
  vehicleExitsRecorded         VehicleMovement[]       @relation("VehicleExitRecorder")

  @@index([tenantId])
  @@index([unitId])
  @@index([isActive])
}

model Staff {
  id                String                  @id @default(uuid())
  empId             String                  @unique
  firstName         String
  lastName          String?
  designation       String?
  department        String?
  phone             String?
  email             String?
  joiningDate       DateTime?
  status            String                  @default("Working")
  photoUrl          String?
  userId            String?                 @unique
  metadata          Json?
  skills            String[]                @default([])
  location          String?
  isAvailable       Boolean                 @default(true)
  performanceScore  Float                   @default(50)
  workload          Int                     @default(0)
  currentWorkload   Int                     @default(0)
  latitude          Float?
  longitude         Float?
  shiftStart        String?
  shiftEnd          String?
  capacity          Int                     @default(5)
  stressLevel       Float                   @default(0)
  lastActiveAt      DateTime?
  tenantId          String
  unitId            String
  isDeleted         Boolean                 @default(false)
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  allocations       Allocation[]
  MedicalAssignment MedicalAssignment[]
  user              User?                   @relation(fields: [userId], references: [id])
  outingCompanions  ResidentOutingRequest[]
  assignedTasks     Task[]
  documents         StaffDocument[]
  attendanceLogs    AttendanceLog[]
  leaveRequests     LeaveRequest[]
  incidentLogs      StaffIncidentLog[]
  payrollRecords    PayrollRecord[]
  salary            StaffSalary?
  dailyMovements    StaffDailyMovement[]
  tripCompanions    StaffGateTrip[]         @relation("StaffTripCompanion")

  @@index([tenantId])
  @@index([unitId])
}

model StaffDocument {
  id           String   @id @default(uuid())
  staffId      String
  tenantId     String
  unitId       String
  documentType String
  fileName     String
  fileUrl      String
  filePath     String
  status       String
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tenantId])
  @@index([unitId])
}

model StaffSalary {
  id             String   @id @default(uuid())
  staffId        String   @unique
  tenantId       String
  unitId         String
  monthlySalary  Float
  fixedAllowance Float
  fixedDeduction Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([tenantId, unitId])
}

model AttendanceLog {
  id        String    @id @default(uuid())
  staffId   String
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  method    String    @default("Manual")
  status    String    @default("Present")
  metadata  Json?
  tenantId  String
  unitId    String
  staff     Staff     @relation(fields: [staffId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([tenantId, unitId, date])
  @@index([status, date])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  staffId     String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING")
  requestedBy String?
  approvedBy  String?
  remarks     String?
  tenantId    String
  unitId      String
  staff       Staff    @relation(fields: [staffId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PayrollRecord {
  id                String    @id @default(uuid())
  staffId           String
  tenantId          String
  unitId            String
  month             String
  workingDays       Int
  presentDays       Int
  approvedLeaveDays Int
  absentDays        Int
  baseSalary        Float
  fixedAllowance    Float
  fixedDeduction    Float
  grossPay          Float
  deductions        Float
  netPay            Float
  status            String
  processedAt       DateTime?
  processedBy       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
  @@index([tenantId, unitId, month])
  @@index([staffId, month])
}

model StaffIncidentLog {
  id          String   @id @default(uuid())
  staffId     String
  category    String
  description String
  date        DateTime @default(now())
  reportedBy  String?
  actionTaken String?
  tenantId    String
  unitId      String
  staff       Staff    @relation(fields: [staffId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model City {
  id        String    @id @default(uuid())
  name      String
  state     String
  country   String
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, state, country, tenantId, unitId])
  @@index([tenantId])
  @@index([unitId])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  state     String
  country   String
  pincode   String?
  createdAt DateTime @default(now())
  units     Unit[]

  @@unique([name, state, country, pincode])
  @@index([name])
  @@index([state])
  @@index([country])
}

model Client {
  id              String            @id @default(uuid())
  refNo           String            @unique
  name            String
  mobile          String
  email           String?
  address         String?
  tenantId        String
  unitId          String
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ChannelIdentity ChannelIdentity[]
  conversations   Conversation[]
  enquiries       Enquiry[]

  @@index([tenantId])
  @@index([unitId])
  @@index([mobile])
}

model JobApplication {
  id             String    @id @default(uuid())
  applicationNo  String    @unique
  companyUnit    String
  applyFor       String
  experience     String?
  location       String?
  applicantName  String
  mobileNo       String
  email          String?
  resumeUrl      String?
  followupStatus String    @default("Pending")
  interestStatus String    @default("Neutral")
  tenantId       String
  unitId         String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model Enquiry {
  id                  String              @id @default(uuid())
  refNo               String              @unique
  clientId            String
  serviceId           String?
  mode                String?
  source              String?
  channelId           String?
  rawMessage          String?
  description         String?
  status              EnquiryStatus       @default(NEW)
  priority            String?
  intent              String?
  sentiment           String?
  summary             String?
  urgency             String?
  isConverted         Boolean?            @default(false)
  convertedAt         DateTime?
  serviceRequirements Json?
  tenantId            String
  unitId              String
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  admission           Admission?
  allocation          Allocation?
  automationScores    AutomationScore[]
  conversations       Conversation[]
  client              Client              @relation(fields: [clientId], references: [id])
  service             ClientService?      @relation(fields: [serviceId], references: [id])
  followUps           FollowUp[]
  MedicalAssignment   MedicalAssignment[]
  tasks               Task[]
  Referral            Referral?

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model Admission {
  id                String              @id @default(uuid())
  enquiryId         String?             @unique
  patientId         String
  tenantId          String
  unitId            String
  status            String              @default("ACTIVE")
  admissionPriority String?
  healthCondition   String?
  clinicalStatus    String?
  floor             String?
  room              String?
  bed               String?
  admittedAt        DateTime            @default(now())
  dischargedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  enquiry           Enquiry?            @relation(fields: [enquiryId], references: [id])
  patient           Patient             @relation(fields: [patientId], references: [id])
  MedicalAssignment MedicalAssignment[]
  serviceContract   ServiceContract?
  serviceClosure    ServiceClosure?
  allocation        Allocation?

  @@index([tenantId])
  @@index([unitId])
  @@index([patientId])
}

model FollowUp {
  id                 String    @id @default(uuid())
  enquiryId          String
  notes              String?
  scheduledAt        DateTime?
  actualAt           DateTime?
  channel            String?   @default("CALL")
  category           String?
  priority           String?   @default("NORMAL")
  response           Boolean   @default(false)
  converted          Boolean   @default(false)
  responseAt         DateTime?
  outcome            String?   @default("PENDING")
  variant            String?
  successScore       Float     @default(0)
  clientInterest     String?
  readyToPayAmount   Float?
  paymentMode        String?
  nextFollowupStatus String?
  assignedStaffId    String?
  tenantId           String
  unitId             String
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  enquiry            Enquiry   @relation(fields: [enquiryId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([scheduledAt])
}

model Allocation {
  id                String               @id @default(uuid())
  refNo             String               @unique
  enquiryId         String?              @unique
  admissionId       String?              @unique
  type              AllocationType       @default(HOME_CARE)
  staffId           String?
  startDate         DateTime?
  endDate           DateTime?
  status            AllocationStatus     @default(PENDING)
  metadata          Json?
  allocationScore   Float?               @default(0)
  tenantId          String
  unitId            String
  isDeleted         Boolean              @default(false)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          AccountTransaction[]
  enquiry           Enquiry?             @relation(fields: [enquiryId], references: [id])
  admission         Admission?           @relation(fields: [admissionId], references: [id])
  staff             Staff?               @relation(fields: [staffId], references: [id])
  MedicalAssignment MedicalAssignment[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model AccountTransaction {
  id                 String            @id @default(uuid())
  refNo              String            @unique
  allocationId       String?
  type               TransactionType
  amount             Float
  paymentMode        String?
  category           String?
  clientName         String?
  status             TransactionStatus @default(CREATED)
  notes              String?
  discountAmount     Float?            @default(0)
  discountApprovedBy String?
  metadata           Json?
  date               DateTime          @default(now())
  tenantId           String
  unitId             String
  isDeleted          Boolean           @default(false)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  allocation         Allocation?       @relation(fields: [allocationId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([type])
}

model Task {
  id                  String              @id @default(uuid())
  refNo               String              @unique
  title               String
  description         String?
  priority            String              @default("MEDIUM")
  aiSummary           String?
  aiUrgency           String?
  enquiryId           String?
  assigneeId          String?
  assignedStaffId     String?
  approvalAuthorityId String?
  type                String              @default("DAILY")
  dueDate             DateTime?
  status              TaskStatus          @default(ASSIGNED)
  completedAt         DateTime?
  feedbackScore       Float               @default(0)
  tenantId            String
  unitId              String
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  MedicalAssignment   MedicalAssignment[]
  approvalAuthority   User?               @relation("TaskApprovalAuthority", fields: [approvalAuthorityId], references: [id])
  assignedStaff       Staff?              @relation(fields: [assignedStaffId], references: [id])
  assignee            User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  enquiry             Enquiry?            @relation(fields: [enquiryId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([enquiryId])
}

model Complaint {
  id          String            @id @default(uuid())
  refNo       String            @unique
  title       String
  type        String?
  description String
  status      ComplaintStatus   @default(OPEN)
  priority    String?
  sentiment   String?
  urgency     String?
  serviceTag  String?
  channel     String?
  channelId   String?
  metadata    Json?
  tenantId    String
  unitId      String
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  scores      AutomationScore[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model WorkflowLog {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  fromState  String?
  toState    String
  actionBy   String
  notes      String?
  tenantId   String
  unitId     String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([tenantId])
}

model Approval {
  id         String         @id @default(uuid())
  entityType String
  entityId   String
  approverId String?
  status     ApprovalStatus @default(PENDING)
  comments   String?
  tenantId   String
  unitId     String
  isDeleted  Boolean        @default(false)
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  approver   User?          @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([entityType, entityId])
  @@index([tenantId])
  @@index([status])
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  module    String
  action    String
  payload   Json?
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([module])
  @@index([createdAt])
}

model FileStorage {
  id         String    @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  entityType String?
  entityId   String?
  tenantId   String
  unitId     String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model RefCounter {
  id       String @id @default(uuid())
  prefix   String
  current  Int    @default(0)
  tenantId String
  unitId   String

  @@unique([prefix, tenantId])
}

model Blog {
  id          String    @id @default(uuid())
  unitName    String?
  title       String
  date        String?
  keywords    String?
  description String?
  images      String[]  @default([])
  status      String    @default("Draft")
  tenantId    String
  unitId      String
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model ClientService {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  category  String
  price     Float
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  enquiries Enquiry[]

  @@index([tenantId])
  @@index([unitId])
}

model Department {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  head       String?
  totalStaff Int       @default(0)
  status     Boolean   @default(true)
  tenantId   String
  unitId     String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model LabourService {
  id        String    @id @default(uuid())
  code      String    @unique
  type      String
  rate      Float
  agency    String?
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model PaymentCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  type        String
  description String?
  status      Boolean   @default(true)
  tenantId    String
  unitId      String
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model Vendor {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  category  String
  contact   String?
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model StockMovement {
  id            String        @id @default(uuid())
  productId     String
  movementType  String
  quantity      Int
  balanceAfter  Int?
  referenceType String?
  referenceId   String?
  batchId       String?
  notes         String?
  performedBy   String?
  tenantId      String
  unitId        String
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  product       Product       @relation(fields: [productId], references: [id])
  batch         ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([productId])
  @@index([movementType])
  @@index([referenceId])
  @@index([createdAt])
}

model Room {
  id        String    @id @default(uuid())
  code      String    @unique
  floor     String?
  type      String
  capacity  Int       @default(1)
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model VitalSign {
  id                String             @id @default(uuid())
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id])
  bp                String?
  pulse             Int?
  temp              Float?
  spO2              Int?
  bloodSugar        String?
  notes             String?
  shift             String?
  recordedAt        DateTime           @default(now())
  department        String?
  recordedById      String
  verified          Boolean            @default(false)
  verifiedBy        String?
  verificationNotes String?
  assignmentId      String?
  assignment        MedicalAssignment? @relation(fields: [assignmentId], references: [id])
  tenantId          String
  unitId            String
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([patientId])
  @@index([patientId, createdAt])
  @@index([patientId, recordedAt])
  @@index([tenantId])
}

