model MedicalAssignment {
  id                  String                  @id
  refNo               String                  @unique
  staffId             String
  patientId           String?
  admissionId         String?
  enquiryId           String?
  taskId              String?
  allocationId        String?
  dutyType            String                  @default("ROUND")
  role                String?
  location            String?
  startAt             DateTime
  endAt               DateTime?
  status              MedicalAssignmentStatus @default(ASSIGNED)
  priority            String                  @default("MEDIUM")
  notes               String?
  metadata            Json?
  assignedById        String?
  tenantId            String
  unitId              String
  isDeleted           Boolean                 @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  Admission           Admission?              @relation(fields: [admissionId], references: [id])
  Allocation          Allocation?             @relation(fields: [allocationId], references: [id])
  Enquiry             Enquiry?                @relation(fields: [enquiryId], references: [id])
  Patient             Patient?                @relation(fields: [patientId], references: [id])
  Staff               Staff                   @relation(fields: [staffId], references: [id])
  Task                Task?                   @relation(fields: [taskId], references: [id])
