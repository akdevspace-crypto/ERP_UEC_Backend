model ADLRecord {
  id                   String             @id @default(uuid())
  patientId            String
  patient              Patient            @relation(fields: [patientId], references: [id])
  mobility             String?
  hygiene              String?
  feeding              String?
  notes                String?
  status               String
  recordedById         String?
  activityCategory     String?
  isMandatory          Boolean            @default(false)
  isCompleted          Boolean            @default(false)
  requiresVerification Boolean            @default(false)
  verifiedBy           String?
  assignedStaffId      String?
  assignmentId         String?
  assignment           MedicalAssignment? @relation(fields: [assignmentId], references: [id])
  scheduledDate        DateTime?
  verificationNotes    String?

  tenantId  String
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
}

model Incident {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  title         String
  description   String
  date          DateTime
  severity      String
  witnesses     String?
  actionTaken   String?
  category      String?
  attachments   Json?
  status        String   @default("OPEN")
  closedBy      String?
  notifiedRoles Json?

  tenantId  String
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
}

// --- B2P CRM Models ---
model ReferralPartner {
  id        String     @id @default(uuid())
  name      String
  type      String // HOSPITAL, DOCTOR, INSURANCE, AGENCY, OTHER
  contact   String?
  email     String?
  status    Boolean    @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  referrals Referral[]

  @@index([tenantId])
  @@index([unitId])
}

model Referral {
  id        String          @id @default(uuid())
  partnerId String
  enquiryId String          @unique
  status    String          @default("PENDING") // PENDING, CONVERTED, REJECTED
  notes     String?
  tenantId  String
  unitId    String
  isDeleted Boolean         @default(false)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  partner   ReferralPartner @relation(fields: [partnerId], references: [id])
  enquiry   Enquiry         @relation(fields: [enquiryId], references: [id])

  @@index([tenantId])
  @@index([unitId])
}

// --- Marketing Model ---
model MarketingCampaign {
  id        String    @id @default(uuid())
  title     String
  type      String // SOCIAL, EMAIL, PRINT, EVENT, OTHER
  budget    Float     @default(0)
  status    String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  startDate DateTime?
  endDate   DateTime?
