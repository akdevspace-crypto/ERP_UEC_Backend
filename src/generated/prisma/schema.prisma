  @@index([tenantId])
  @@index([unitId])
}

// --- Visit Reporting Model ---
model FacilityVisit {
  id          String    @id @default(uuid())
  visitorName String
  contact     String?
  patientId   String? // Optional, if visiting a specific resident
  purpose     String?
  checkIn     DateTime  @default(now())
  checkOut    DateTime?
  tenantId    String
  unitId      String
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
