  exitUser  User? @relation("VehicleExitRecorder", fields: [exitUserId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([vehicleNo])
  @@index([status])
  @@index([entryAt])
  @@index([exitAt])
  @@index([tenantId, unitId, status])
}
