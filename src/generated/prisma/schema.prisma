  @@index([allocationId], map: "PatientDailyCost_allocation_idx")
  @@index([costDate])
  @@index([sourceType, sourceId])
  @@index([sourceType, sourceId], map: "PatientDailyCost_source_idx")
  @@index([status])
  @@index([tenantId, unitId])
  @@index([tenantId, unitId], map: "PatientDailyCost_tenant_unit_idx")
}

